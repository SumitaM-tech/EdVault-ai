# ---- Server ----
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Used to build the verification URL that is encoded in each credential's QR code
FRONTEND_URL=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://edvault:edvault@localhost:5432/edvault?schema=public

# ---- Auth ----
# scripts\setup.ps1 replaces this with a random value. Must be 16+ characters.
JWT_SECRET=replace-me-run-scripts-setup-ps1
JWT_EXPIRES_IN=7d

# ---- Blockchain (local Hardhat node) ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Leave blank: scripts\start-chain.ps1 deploys the contract and the backend reads deployments\localhost.json
CONTRACT_ADDRESS=
# Hardhat's well-known PUBLIC test key #0 (local chain only; never use on a real network)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- IPFS (Pinata) ----
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Set PINATA_JWT (or PINATA_API_KEY + PINATA_SECRET_KEY) to pin documents for real.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ---- Simulation switch ----
# true : a service with NO credentials configured runs in a clearly labelled simulated mode
#        (see GET /health). A configured service that fails never falls back to a simulation.
# false: unconfigured services reject requests instead.
ALLOW_MOCK_SERVICES=true

# ---- Optional ----
GROQ_API_KEY=
RESEND_API_KEY=

# ---- Sepolia public testnet (optional; see scripts\deploy-sepolia.ps1) ----
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<key>
# For Sepolia set DEPLOYER_PRIVATE_KEY to YOUR OWN throwaway wallet (never the Hardhat key above).
